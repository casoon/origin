{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__PRODUCT_NAME__",
  "version": "0.1.0",
  "identifier": "__PRODUCT_ID__",
  "build": {
    "beforeDevCommand": "pnpm --filter __PACKAGE_NAME__-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter __PACKAGE_NAME__-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "__PRODUCT_NAME__",
        "width": 980,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
